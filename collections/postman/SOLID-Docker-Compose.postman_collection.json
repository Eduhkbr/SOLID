    {
      "name": "02 - Receipt Service",
      "description": "Endpoints do microsserviço Receipt executando na porta 8083.\nOs comprovantes são produzidos de forma assíncrona por eventos RabbitMQ. Quando ainda não há comprovante, retorna HTTP 204 No Content. Quando processado, retorna HTTP 200 OK com os dados do comprovante.",
      "item": [
        {
          "name": "Find Receipt - Credit Card Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 (comprovante pronto) ou 204 (processamento assíncrono pendente)', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var body = pm.response.json();",
                  "    pm.test('Comprovante possui paymentId', function () {",
                  "        pm.expect(body).to.have.property('paymentId');",
                  "    });",
                  "    pm.test('Comprovante possui receiptData', function () {",
                  "        pm.expect(body).to.have.property('receiptData');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{receiptBaseUrl}}/receipts/{{paymentId}}"
          }
        },
        {
          "name": "Find Receipt - PIX Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 ou 204', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{receiptBaseUrl}}/receipts/{{pixPaymentId}}"
          }
        },
        {
          "name": "Find Receipt - Boleto Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 ou 204', function () {",
                  "    pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{receiptBaseUrl}}/receipts/{{boletoPaymentId}}"
          }
        },
        {
          "name": "Find Receipt - Unknown Payment (Expected 204)",
          "description": "Para ID inexistente, a Receipt API retorna 204 No Content.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 - Nenhum comprovante encontrado', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
