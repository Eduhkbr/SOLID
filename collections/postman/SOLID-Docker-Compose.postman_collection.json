                  "});",
                  "var body = pm.response.json();",
                  "if (body && body.paymentId) {",
                  "    pm.environment.set('boletoPaymentId', body.paymentId);",
                  "    pm.collectionVariables.set('boletoPaymentId', body.paymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"BOLETO\",\n  \"amount\": 250.00\n}"
            },
            "url": "{{paymentBaseUrl}}/payments"
          }
        },
        {
          "name": "Find Payment - Boleto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Boleto encontrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('paymentMethod é BOLETO', function () {",
                  "    pm.expect(body.paymentMethod).to.eql('BOLETO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/{{boletoPaymentId}}"
          }
        },
        {
          "name": "Refund Payment (Boleto)",
          "description": "Boleto permite estorno enquanto estiver com status PENDING.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Estorno de Boleto aceito', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Status é REFUNDED', function () {",
                  "    pm.expect(body.status).to.eql('REFUNDED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/refund/{{boletoPaymentId}}"
          }
        },
        {
          "name": "Payment API - Host Instance",
          "description": "Retorna o hostname do contêiner que processou a requisição.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Hostname retornado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/host"
          }
        },
        {
          "name": "Error Scenarios",
          "description": "Validação de respostas de erro da Payment API (400, 404).",
          "item": [
