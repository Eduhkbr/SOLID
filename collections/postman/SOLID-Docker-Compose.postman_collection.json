  "item": [
    {
      "name": "01 - Payment Service",
      "description": "Endpoints do microsserviço Payment executando na porta 8082.",
      "item": [
        {
          "name": "Create Payment - Credit Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 - Pagamento criado com sucesso', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Retorno contém paymentId', function () {",
                  "    pm.expect(body).to.have.property('paymentId');",
                  "});",
                  "pm.test('Status inicial é PENDING', function () {",
                  "    pm.expect(body.status).to.eql('PENDING');",
                  "});",
                  "pm.test('Dados sensíveis do cartão não são retornados', function () {",
                  "    pm.expect(body).to.not.have.property('cardNumber');",
                  "    pm.expect(body).to.not.have.property('cvv');",
                  "});",
                  "if (body && body.paymentId) {",
                  "    pm.environment.set('paymentId', body.paymentId);",
                  "    pm.collectionVariables.set('paymentId', body.paymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"amount\": 199.90,\n  \"cardNumber\": \"1234567890123456\",\n  \"cvv\": \"123\"\n}"
            },
            "url": "{{paymentBaseUrl}}/payments"
          }
        },
        {
          "name": "Find Payment by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Pagamento encontrado', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "var expectedId = pm.environment.get('paymentId') || pm.collectionVariables.get('paymentId');",
                  "pm.test('paymentId confere com o criado', function () {",
                  "    pm.expect(body.paymentId).to.eql(expectedId);",
                  "});",
                  "pm.test('Valor confere com o enviado', function () {",
                  "    pm.expect(body.amount).to.eql(199.90);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/{{paymentId}}"
          }
        },
        {
          "name": "Refund Payment (Credit Card)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Estorno realizado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Status atualizado para REFUNDED', function () {",
                  "    pm.expect(body.status).to.eql('REFUNDED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/refund/{{paymentId}}"
          }
        },
        {
          "name": "Find Payment After Refund",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Pagamento consultado após estorno', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var body = pm.response.json();",
                  "pm.test('Status confirmado como REFUNDED', function () {",
                  "    pm.expect(body.status).to.eql('REFUNDED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/{{paymentId}}"
          }
        },
        {
          "name": "Create Payment - PIX",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 - PIX criado com sucesso', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var body = pm.response.json();",
                  "if (body && body.paymentId) {",
                  "    pm.environment.set('pixPaymentId', body.paymentId);",
                  "    pm.collectionVariables.set('pixPaymentId', body.paymentId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"PIX\",\n  \"amount\": 89.90,\n  \"pixKey\": \"cliente@exemplo.com\"\n}"
            },
            "url": "{{paymentBaseUrl}}/payments"
          }
        },
        {
          "name": "Try Refund PIX (Expected 409 Conflict)",
          "description": "PIX não permite estorno automático neste simulador. Deve responder 409 Conflict.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409 - Estorno negado para PIX', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{paymentBaseUrl}}/payments/refund/{{pixPaymentId}}"
          }
        },
        {
          "name": "Create Payment - Boleto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 - Boleto criado com sucesso', function () {",
