              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"amount\": 50.00,\n  \"cardNumber\": \"123\",\n  \"cvv\": \"1\"\n}"
